# Copie para ".env" (na raiz do app, ao lado do package.json) e troque pelo IP do PC que roda a API.
# Descubra o IP com "ipconfig" (Windows) ou "ip a" (Linux). Celular e PC precisam estar no mesmo Wi-Fi.
# Se não criar o .env, o app usa o mesmo IP do PC que roda o "npx expo start", na porta 8000.
EXPO_PUBLIC_API_URL=http://192.168.0.10:8000

# ================= BANCO DE DADOS (MySQL) =================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql
DB_PORT=3306
DB_NAME=parksync
# Opcional, só para testes sem MySQL (sobrescreve as linhas acima):
# DATABASE_URL=sqlite:///parksync_teste.db

# ================= SEGURANÇA =================
# Gere uma chave com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque_por_uma_chave_grande_e_aleatoria
JWT_EXPIRA_MINUTOS=10080
# false = o app atual funciona sem mandar token. true = exige "Authorization: Bearer <token>".
EXIGIR_TOKEN=false
# Opcional: se preencher, as rotas da portaria exigem o header X-Portaria-Key.
# Se deixar vazio, elas só aceitam chamadas do próprio computador (127.0.0.1).
PORTARIA_API_KEY=

# ================= CÂMERAS =================
# Webcam do reconhecimento facial (a MESMA para entrada e saída). 0 = primeira webcam USB.
FACE_CAM=0
# ESP32-CAM de cada lado (IP que aparece no Serial Monitor). O /capture é adicionado sozinho.
PE_PLATE_CAM=http://192.168.1.50:81
PS_PLATE_CAM=http://192.168.1.51:81
# Webcam de cima, apontada para as vagas
PM_PARK_CAM=1

# ================= VISÃO COMPUTACIONAL =================
# Distância máxima do rosto (menor = mais rígido). 0.5 é um bom começo.
FACIAL_THRESHOLD=0.5
# Segundos que a webcam fica procurando o rosto
TEMPO_BUSCA_ROSTO=4
# % da vaga que precisa mudar em relação ao fundo vazio para contar como ocupada
OCUPACAO_PERCENTUAL=15
# Segundos que a vaga precisa ficar ocupada para confirmar
TEMPO_CONFIRMA_VAGA=5
# Tamanho da tela de desenho do vagas.html
FRONT_LARGURA=800
FRONT_ALTURA=600
MONITORAR_VAGAS=true

# ================= REGRAS DE ACESSO =================
# Morador reconhecido chegando com carro que não é dele entra como "temporário" (1 por vez)
PERMITIR_VEICULO_TEMPORARIO=true

# ================= MQTT (Mosquitto) =================
MQTT_IP=127.0.0.1
MQTT_PORT=1883
MQTT_TIMEOUT=60
# Só se o Mosquitto tiver usuário/senha:
MQTT_USER=
MQTT_PASSWORD=
